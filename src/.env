# Application
APP_PORT=3000
APP_HOST=0.0.0.0
APP_DEBUG=false
APP_OS=Chrome

# Optional security
# APP_BASIC_AUTH=admin:password123

# Optional if deployed under subpath
# APP_BASE_PATH=/gowa

# Reverse proxy
# APP_TRUSTED_PROXIES=0.0.0.0/0

# Database
DB_URI=file:storages/whatsapp.db?_foreign_keys=on

# Optional separate key database
# DB_KEYS_URI=file:storages/whatsapp-keys.db?_foreign_keys=on

# WhatsApp
WHATSAPP_AUTO_MARK_READ=false
WHATSAPP_AUTO_DOWNLOAD_MEDIA=true
WHATSAPP_ACCOUNT_VALIDATION=true
WHATSAPP_PRESENCE_ON_CONNECT=unavailable

# Auto reply (optional)
# WHATSAPP_AUTO_REPLY="Terima kasih, pesan Anda sudah kami terima."

# Webhook (optional)
# WHATSAPP_WEBHOOK=https://your-domain.com/webhook
WHATSAPP_WEBHOOK_SECRET=secret
WHATSAPP_WEBHOOK_INSECURE_SKIP_VERIFY=false

# Forward only selected events (optional)
# WHATSAPP_WEBHOOK_EVENTS=message,message.ack

# Presence pulse
WHATSAPP_PRESENCE_PULSE_ENABLED=true
WHATSAPP_PRESENCE_PULSE_INTERVAL=24h
WHATSAPP_PRESENCE_PULSE_DURATION=5m

# Chatwoot Integration
CHATWOOT_ENABLED=false

# Uncomment below if using Chatwoot
# CHATWOOT_URL=https://app.chatwoot.com
# CHATWOOT_API_TOKEN=your-api-token
# CHATWOOT_ACCOUNT_ID=12345
# CHATWOOT_INBOX_ID=67890
# CHATWOOT_DEVICE_ID=628xxxxxxxxxx@s.whatsapp.net

# Message import
CHATWOOT_IMPORT_MESSAGES=false
CHATWOOT_DAYS_LIMIT_IMPORT_MESSAGES=3

# Direct DB import (optional)
# CHATWOOT_IMPORT_DB_URI=postgresql://user:pass@host:5432/chatwoot_production?sslmode=disable
CHATWOOT_IMPORT_PLACEHOLDER_MEDIA_MESSAGE=true
